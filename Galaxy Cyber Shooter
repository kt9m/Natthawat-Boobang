  let total = 0; types.forEach(t => total += ITEMS[t].weight);
  let r = Math.random() * total, pick = types[0];
  for(const t of types){ r -= ITEMS[t].weight; if(r <= 0){ pick = t; break; } }
  items.push({ x, y, type: pick, vy: 1.6, r: 16, t: 0 });
}
function collect(it){
  const d = ITEMS[it.type];
  toast(it.x, it.y, d.toast, d.color);
  beep(900, .1, 'triangle', .06); setTimeout(() => beep(1300, .1, 'triangle', .06), 70);
