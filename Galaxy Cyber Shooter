<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>Galaxy Cyber Shooter</title>
<style>
  html,body{margin:0;height:100%;background:#02030a;overflow:hidden;
    font-family:Tahoma,"Segoe UI",sans-serif;-webkit-user-select:none;user-select:none}
  body{display:flex;align-items:center;justify-content:center}
  #wrap{position:relative;flex:none;width:480px;height:720px;transform-origin:center center;
    box-shadow:0 0 40px #00f0ff55,0 0 0 2px #00f0ff88;border-radius:8px;overflow:hidden}
  #c{width:480px;height:720px;display:block;touch-action:none;background:#02030a}
  #wrap::after{content:"";position:absolute;inset:0;pointer-events:none;z-index:5;
    background:repeating-linear-gradient(to bottom,rgba(0,240,255,.05) 0 1px,transparent 1px 3px)}
  .hide{display:none!important}

  .screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
    z-index:2;color:#cfeaff;text-align:center}
  h1{margin:0;font-size:36px;line-height:1.1;letter-spacing:2px;color:#00f0ff;
    text-shadow:0 0 8px #00f0ff,0 0 22px #00f0ff,0 0 44px #ff2bd6}
  p{margin:0;font-size:18px;line-height:1.6}
  .tag{font-family:"Courier New",monospace;color:#ff2bd6;letter-spacing:4px;font-size:14px;
    text-shadow:0 0 8px #ff2bd6;margin-bottom:8px}
  .stack{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%}

  button{font-family:inherit;cursor:pointer;border:none}
  button:active{transform:scale(.96)}
  .big{font-size:24px;font-weight:bold;color:#02030a;background:#00f0ff;border-radius:14px;
    padding:13px 0;width:300px;box-shadow:0 0 18px #00f0ff,0 0 40px #00f0ff88}
  .big.mag{background:#ff2bd6;box-shadow:0 0 18px #ff2bd6,0 0 40px #ff2bd688}
  .ghost{font-size:15px;color:#00f0ff;background:transparent;border:1px solid #00f0ff;
    border-radius:10px;padding:7px 16px}
  .pills{display:flex;gap:8px}
  .pill{font-size:16px;font-weight:bold;color:#9fe8ff;background:#0b1d33;border:1px solid #00f0ff66;
    border-radius:20px;padding:7px 18px}
  .pill.on{color:#02030a;background:#9dff00;border-color:#9dff00;box-shadow:0 0 14px #9dff00aa}

  #home{justify-content:space-between;padding:54px 24px 30px;
    background:linear-gradient(rgba(2,3,10,.35),rgba(2,3,10,.05) 45%,rgba(2,3,10,.75))}
  #end{justify-content:center;gap:14px;background:rgba(2,3,10,.85);padding:20px}

  /* ---------- ห้องแต่งยาน ---------- */
  #lab{justify-content:flex-start;gap:6px;padding:10px 14px;background:#04051a}
  .labhead{font-size:20px;font-weight:bold;color:#00f0ff;text-shadow:0 0 10px #00f0ff}
  .labhead small{display:block;font-size:13px;color:#8fb7d6;font-weight:normal;text-shadow:none}
  #pv{width:440px;height:100px;border:1px solid #00f0ff66;border-radius:10px;background:#05061a}
  .row{display:flex;align-items:center;gap:6px;width:440px;height:32px}
  .row label{width:74px;text-align:left;font-size:14px;color:#8fb7d6;flex:none}
  .chip{font-size:14px;color:#9fe8ff;background:#0b1d33;border:1px solid #00f0ff66;border-radius:9px;padding:5px 10px}
  .sw{width:28px;height:28px;border-radius:50%;border:2px solid #ffffff55;padding:0}
  #code{width:440px;height:160px;box-sizing:border-box;resize:none;background:#020410;color:#9dff00;
    border:1px solid #00f0ff66;border-radius:10px;padding:8px;font:13px/1.45 "Courier New",monospace;
    -webkit-user-select:text;user-select:text;outline:none}
  #code:focus{border-color:#00f0ff;box-shadow:0 0 10px #00f0ff66}
  #stat{width:440px;min-height:34px;font-size:13px;text-align:left;line-height:1.4}
  .ok{color:#9dff00}.er{color:#ff6a6a}.wn{color:#ffd24d}
  .labbtn{display:flex;gap:8px;width:440px}
  .labbtn button{flex:1;font-size:16px;font-weight:bold;border-radius:12px;padding:11px 4px}
</style>
</head>
<body>
<div id="wrap">
  <canvas id="c" width="480" height="720"></canvas>

  <!-- หน้าหลัก -->
  <div id="home" class="screen">
    <div class="stack">
      <div class="tag">// CYBER GALAXY //</div>
      <h1>GALAXY<br>CYBER SHOOTER</h1>
      <p id="pilot" style="font-size:22px;font-weight:bold;color:#9dff00"></p>
      <p id="slog" style="font-size:15px;color:#8fb7d6"></p>
    </div>
    <div class="stack">
      <p style="font-size:14px;color:#8fb7d6">ระดับความยาก</p>
      <div class="pills" id="diffRow"></div>
      <button class="big" id="btnPlay">▶ เริ่มเล่น</button>
      <button class="big mag" id="btnLab">🧪 ห้องแต่งยาน (เขียนโค้ด)</button>
      <div style="display:flex;gap:14px;align-items:center">
        <span id="best" style="font-size:15px;color:#ffd24d"></span>
        <button class="ghost" id="snd">เสียง: เปิด</button>
      </div>
    </div>
  </div>

  <!-- ห้องแต่งยาน -->
  <div id="lab" class="screen hide">
    <div class="labhead">🧪 ห้องแต่งยาน<small>เขียนโค้ด HTML แต่งยาน! เปิด &lt;h1&gt; ต้องมีปิด &lt;/h1&gt;<br>&lt;h1&gt; ชื่อ · &lt;p&gt; คำพูด · &lt;ship&gt; ตัวยาน · &lt;gun&gt; ปืน · &lt;engine&gt; เครื่อง · &lt;heart&gt; หัวใจ</small></div>
    <canvas id="pv" width="440" height="100"></canvas>
    <div id="chips"></div>
    <textarea id="code" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
    <div id="stat"></div>
    <div class="labbtn">
      <button class="ghost" id="labReset">↺ รีเซ็ต</button>
      <button style="background:#ff2bd6;color:#02030a" id="labSave">💾 บันทึก</button>
      <button style="background:#00f0ff;color:#02030a" id="labPlay">▶ ลองบิน</button>
    </div>
  </div>

  <!-- จบเกม -->
  <div id="end" class="screen hide">
    <h1 id="endT"></h1>
    <p id="endM"></p>
    <button class="big" id="btnAgain">↻ เล่นอีกครั้ง</button>
    <button class="big mag" id="btnHome">🏠 หน้าหลัก</button>
  </div>
</div>

<script>
/* =====================================================
   ⚙️ ตั้งค่าเกม  — แก้ตัวเลขตรงนี้ได้เลย!
   ===================================================== */
const CONFIG = {
  maxLives: 3,            // หัวใจสูงสุด (เริ่มเกม/เก็บหัวใจได้ไม่เกินนี้)
  bulletSpeed: 10,        // ความเร็วกระสุนยาน
  enemySpawnMs: 850,      // ศัตรูโผล่ทุกกี่ มิลลิวินาที (น้อย = ยาก)
  enemySpeed: 1.7,        // ความเร็วศัตรู
  enemyHP: 1,             // เลือดศัตรูธรรมดา
  shooterHP: 2,           // เลือดศัตรูนักยิง
  enemyFireMs: 2400,      // ศัตรูยิงสวนทุกกี่ มิลลิวินาที
  enemyBulletSpeed: 3.0,  // ความเร็วกระสุนศัตรู
  killsForBoss: 20,       // ล้มศัตรูกี่ตัวบอสถึงมา
  bossHP: 40,             // เลือดบอส
  bossFireMs: 1300,       // บอสยิงทุกกี่ มิลลิวินาที
  bossBulletSpeed: 3.2,   // ความเร็วกระสุนบอส
  itemDropChance: 0.28,   // โอกาสศัตรูทิ้งของ
  powerMs: 8000,          // ยิงหลายทางนานกี่ มิลลิวินาที
  shieldMs: 6000,         // โล่นานกี่ มิลลิวินาที
  sound: true,
  colors: {
    drift:   '#ff2bd6',   // ศัตรูบินตรง
    wave:    '#b36bff',   // ศัตรูบินส่าย
    shooter: '#ff5a36',   // ศัตรูนักยิง
    boss:    '#ff3b3b',
    enemyBullet: '#ff6ad5',
    bossBullet:  '#ff8a00'
  },
  text: {
    warning: '⚠ บอสมาแล้ว! ⚠',
    winTitle: 'ชนะแล้ว!<br>เก่งมาก 🏆',
    loseTitle: 'ยานแตก!<br>ลองใหม่นะ'
  }
};

/* ระดับความยาก (คูณกับค่าด้านบน) */
const DIFFS = {
  easy:   { name: 'ง่าย',   spd: 0.85, fire: 0.5, spawn: 1.2, boss: 0.7,  bspd: 0.85 },
  normal: { name: 'ปกติ',   spd: 1,    fire: 1,   spawn: 1,   boss: 1,    bspd: 1 },
  hard:   { name: 'ท้าทาย', spd: 1.25, fire: 1.5, spawn: 0.8, boss: 1.35, bspd: 1.2 }
};

/* ไอเท็มที่เก็บได้ — weight = โอกาสออก */
const ITEMS = {
  heart:  { label: '♥', color: '#ff4d8d', weight: 3, toast: 'หัวใจ +1' },
  power:  { label: 'P', color: '#ffe600', weight: 4, toast: 'ยิงเพิ่ม!' },
  shield: { label: 'S', color: '#4da6ff', weight: 4, toast: 'โล่ป้องกัน!' },
  star:   { label: '★', color: '#ffd24d', weight: 4, toast: 'ดาว +50' },
  bomb:   { label: 'B', color: '#ff8a00', weight: 2, toast: 'ระเบิด!' }
};

/* =====================================================
   🧪 ระบบโค้ดแต่งยาน
   ===================================================== */
const DEFAULT_CODE = [
  '<!-- 🚀 ห้องแต่งยาน: แต่งยานด้วยโค้ด HTML! ทุกแท็กต้องมีตัวปิด -->',
  '<!-- shape: arrow delta wide round | สีพิมพ์ red, blue, ชมพู ก็ได้ -->',
  '',
  '<h1>นักบินน้อย</h1>',
  '<p>พร้อมลุย!</p>',
  '',
  '<ship shape="arrow" color="#00f0ff" flame="#ff8a00"></ship>',
  '<gun color="#9dff00" shots="1" delay="250"></gun>',
  '<engine speed="6"></engine>',
  '<heart>3</heart>'
].join('\n');

const DEFAULT_SHIP = { name: 'นักบินน้อย', slogan: 'พร้อมลุย!', shape: 'arrow', color: '#00f0ff',
  bullet: '#9dff00', flame: '#ff8a00', shots: 1, speed: 6, fireDelay: 250, lives: 3 };

const SHAPE_LIST = ['arrow', 'delta', 'wide', 'round'];
/* แท็กที่ใช้ได้: text = ค่าที่เขียนข้างในแท็ก, attrs = ค่าที่เขียนในแท็กเปิด */
const TAGS = {
  h1:     { text: { key: 'name',   t: 'str', max: 12 } },
  p:      { text: { key: 'slogan', t: 'str', max: 24 } },
  ship:   { attrs: {
            shape: { key: 'shape', t: 'enum', o: SHAPE_LIST },
            color: { key: 'color', t: 'color' },
            flame: { key: 'flame', t: 'color' } } },
  gun:    { attrs: {
            color: { key: 'bullet', t: 'color' },
            shots: { key: 'shots', t: 'num', min: 1, max: 3, int: true },
            delay: { key: 'fireDelay', t: 'num', min: 120, max: 500 } } },
  engine: { attrs: { speed: { key: 'speed', t: 'num', min: 3, max: 9 } } },
  heart:  { text: { key: 'lives', t: 'num', min: 1, max: CONFIG.maxLives, int: true } }
};

const COLOR_NAMES = {
  red:'#ff3b3b', blue:'#3b8bff', green:'#2bff7a', yellow:'#ffe600', pink:'#ff2bd6',
  purple:'#b36bff', orange:'#ff8a00', white:'#ffffff', cyan:'#00f0ff', lime:'#9dff00',
  'แดง':'#ff3b3b', 'น้ำเงิน':'#3b8bff', 'ฟ้า':'#00f0ff', 'เขียว':'#2bff7a', 'เหลือง':'#ffe600',
  'ชมพู':'#ff2bd6', 'ม่วง':'#b36bff', 'ส้ม':'#ff8a00', 'ขาว':'#ffffff'
};
function parseColor(v){
  v = v.toLowerCase();
  if(COLOR_NAMES[v]) return COLOR_NAMES[v];
  if(/^#([0-9a-f]{3}|[0-9a-f]{6})$/.test(v)){
    if(v.length === 4) v = '#' + v[1]+v[1] + v[2]+v[2] + v[3]+v[3];
    return v;
  }
  return null;
}

function checkVal(spec, val, where, line, msgs){
  const pre = `บรรทัด ${line}: ${where} `;
  if(spec.t === 'str'){
    if(!val){ msgs.push({ c: 'wn', t: pre + 'ว่างเปล่า ใส่ข้อความข้างในด้วยนะ' }); return undefined; }
    return val.slice(0, spec.max);
  }
  if(spec.t === 'enum'){
    const v = val.toLowerCase();
    if(spec.o.includes(v)) return v;
    msgs.push({ c: 'er', t: pre + 'เลือกได้แค่ ' + spec.o.join(', ') }); return undefined;
  }
  if(spec.t === 'color'){
    const c = parseColor(val);
    if(c) return c;
    msgs.push({ c: 'er', t: pre + 'สีไม่ถูก ลอง "#00f0ff" หรือ red' }); return undefined;
  }
  const x = Number(val);
  if(val === '' || isNaN(x)){ msgs.push({ c: 'er', t: pre + 'ต้องเป็นตัวเลข' }); return undefined; }
  const cl = Math.max(spec.min, Math.min(spec.max, x));
  if(cl !== x) msgs.push({ c: 'wn', t: pre + `ปรับเป็น ${cl} (ใช้ได้ ${spec.min}-${spec.max})` });
  return spec.int ? Math.round(cl) : cl;
}

/* แปลงโค้ด HTML เป็นค่ายาน (ปลอดภัย: ไม่รันโค้ดจริง แค่อ่านแท็กที่รู้จัก) */
function parseShip(code){
  const s = Object.assign({}, DEFAULT_SHIP), msgs = [];
  const clean = code.replace(/<!--[\s\S]*?-->/g, m => m.replace(/[^\n]/g, ' '));   // ตัดคอมเมนต์ <!-- -->
  const lineAt = i => clean.slice(0, i).split('\n').length;
  const stack = [];
  const er = (line, t) => msgs.push({ c: 'er', t: `บรรทัด ${line}: ${t}` });

  function apply(el){
    const T = TAGS[el.name];
    if(T.text){
      const v = checkVal(T.text, el.text.trim().replace(/\s+/g, ' '), `<${el.name}>`, el.line, msgs);
      if(v !== undefined) s[T.text.key] = v;
    }
    const are = /([a-zA-Z]+)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"']+))/g;
    let a;
    while((a = are.exec(el.attrs))){
      const an = a[1].toLowerCase();
      const av = a[2] !== undefined ? a[2] : (a[3] !== undefined ? a[3] : a[4]);
      const sp = T.attrs && T.attrs[an];
      if(!sp){
        er(el.line, `<${el.name}> ไม่มี "${an}" (ใช้ได้: ${T.attrs ? Object.keys(T.attrs).join(', ') : 'ไม่มี'})`);
        continue;
      }
      const v = checkVal(sp, av.trim(), `<${el.name}> ${an}`, el.line, msgs);
      if(v !== undefined) s[sp.key] = v;
    }
  }
  function addText(txt){
    if(!txt.trim()) return;
    if(stack.length) stack[stack.length-1].text += txt;
    else msgs.push({ c: 'wn', t: `ข้อความ "${txt.trim().slice(0, 14)}" อยู่นอกแท็ก ต้องใส่ไว้ในแท็กนะ` });
  }

  const re = /<\s*(\/?)\s*([^\s<>\/]*)([^<>]*)>/g;
  let last = 0, m;
  while((m = re.exec(clean))){
    addText(clean.slice(last, m.index)); last = re.lastIndex;
    const line = lineAt(m.index), closing = m[1] === '/', name = m[2].toLowerCase();
    let rest = m[3];
    const selfClose = /\/\s*$/.test(rest); if(selfClose) rest = rest.replace(/\/\s*$/, '');
    if(!name){ er(line, 'แท็กว่างเปล่า'); continue; }
    if(!TAGS[name]){ if(!closing) er(line, `ไม่รู้จักแท็ก <${name}>`); continue; }
    if(closing){
      const top = stack.pop();
      if(!top) er(line, `</${name}> ไม่มี <${name}> เปิดไว้`);
      else if(top.name !== name){ er(line, `เจอ </${name}> แต่ต้องปิด </${top.name}> ก่อน`); stack.push(top); }
      else apply(top);
    } else {
      const el = { name, line, attrs: rest, text: '' };
      if(selfClose) apply(el); else stack.push(el);
    }
  }
  const tail = clean.slice(last);
  if(tail.includes('<')) er(lineAt(last + tail.indexOf('<')), 'มี < แต่ลืมปิดด้วย >');
  addText(tail.replace(/<[\s\S]*$/, ''));
  stack.forEach(el => er(el.line, `<${el.name}> ลืมปิดด้วย </${el.name}>`));
  return { ship: s, msgs };
}

/* =====================================================
   🎮 ตัวเกม
   ===================================================== */
const cv = document.getElementById('c'), ctx = cv.getContext('2d');
const W = 480, H = 720;
const wrap = document.getElementById('wrap');
const $ = id => document.getElementById(id);
function fit(){ wrap.style.transform = `scale(${Math.min(innerWidth/W, innerHeight/H)})`; }
addEventListener('resize', fit); fit();

const store = {
  get(k, d){ try{ const v = localStorage.getItem(k); return v === null ? d : v; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem(k, v); }catch(e){} }
};

let ship = parseShip(store.get('gcs_code2', DEFAULT_CODE)).ship;
let diff = store.get('gcs_diff', 'normal'); if(!DIFFS[diff]) diff = 'normal';
let best = parseInt(store.get('gcs_best', '0')) || 0;
const D = () => DIFFS[diff];

/* ---------- เสียง ---------- */
let AC;
function beep(f, d=0.08, type='square', v=0.04){
  if(!CONFIG.sound) return;
  try{
    AC = AC || new (window.AudioContext||window.webkitAudioContext)();
    const o = AC.createOscillator(), g = AC.createGain();
    o.type = type; o.frequency.value = f; g.gain.value = v;
    g.gain.exponentialRampToValueAtTime(0.0001, AC.currentTime + d);
    o.connect(g); g.connect(AC.destination); o.start(); o.stop(AC.currentTime + d);
  }catch(e){}
}
$('snd').onclick = () => { CONFIG.sound = !CONFIG.sound; $('snd').textContent = 'เสียง: ' + (CONFIG.sound ? 'เปิด' : 'ปิด'); beep(700); };

/* ---------- ตัวควบคุม ---------- */
let tx = W/2, ty = H-120;
function pp(e){
  if(state !== 'play') return;
  const r = cv.getBoundingClientRect();
  tx = (e.clientX - r.left) * W / r.width;
  ty = (e.clientY - r.top) * H / r.height - (e.pointerType === 'touch' ? 70 : 0);
}
cv.addEventListener('pointerdown', e => { pp(e); try{cv.setPointerCapture(e.pointerId);}catch(_){} });
cv.addEventListener('pointermove', pp);
const keys = {};
addEventListener('keydown', e => {
  if(e.target && e.target.tagName === 'TEXTAREA') return;
  const k = e.key.toLowerCase(); keys[k] = true;
  if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k)) e.preventDefault();
  if(k === 'enter' && (state === 'menu' || state === 'over' || state === 'win')) startGame();
});
addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

/* ---------- ตัวแปรเกม ---------- */
let state = 'menu', last = 0;
let p, bullets, ebullets, enemies, items, parts, toasts, boss;
let score, kills, spawnT, bossStarted, warnT, winT, shake, flash;

const stars = Array.from({length: 70}, () => ({ x: Math.random()*W, y: Math.random()*H, z: 0.3 + Math.random()*1.7 }));
let gridOff = 0;

function reset(){
  p = { x: W/2, y: H-120, r: 14, fire: 0, power: 0, shield: 0, inv: 0, lives: ship.lives };
  tx = p.x; ty = p.y;
  bullets = []; ebullets = []; enemies = []; items = []; parts = []; toasts = [];
  boss = null; score = 0; kills = 0; spawnT = 700;
  bossStarted = false; warnT = 0; winT = 0; shake = 0; flash = 0;
}
reset();

/* ---------- สลับหน้าจอ ---------- */
function show(id){ ['home','lab','end'].forEach(x => $(x).classList.toggle('hide', x !== id)); }
function refreshHome(){
  $('pilot').textContent = '🚀 ' + ship.name; $('slog').textContent = ship.slogan;
  $('best').textContent = '🏆 คะแนนสูงสุด ' + best;
  document.querySelectorAll('#diffRow .pill').forEach(b => b.classList.toggle('on', b.dataset.d === diff));
}
function goHome(){ state = 'menu'; reset(); show('home'); refreshHome(); }
function startGame(){
  reset(); state = 'play'; show(null); toast(W/2, H-200, ship.slogan, '#9dff00');
  beep(520, .1); setTimeout(() => beep(780, .15), 90);
}
function showEnd(win){
  state = win ? 'win' : 'over';
  let extra = '';
  if(score > best){ best = score; store.set('gcs_best', String(best)); extra = '<br>🎉 คะแนนสูงสุดใหม่!'; }
