/* แก้ค่า attribute ในแท็กเปิด เช่น <ship color="..."> */
function setAttr(tag, attr, val){
  const ta = $('code'); let code = ta.value;
  const re = new RegExp('<' + tag + '(\\s[^<>]*)?>', 'i');
  const m = code.match(re);
  if(!m){ code += `\n<${tag} ${attr}="${val}"></${tag}>`; }
  else {
    let attrs = m[1] || '';
    const self = /\/\s*$/.test(attrs); attrs = attrs.replace(/\/\s*$/, '');
    const are = new RegExp('(^|\\s)' + attr + '\\s*=\\s*("[^"]*"|\'[^\']*\'|[^\\s"\']+)', 'i');
    if(are.test(attrs)) attrs = attrs.replace(are, (x, sp) => `${sp}${attr}="${val}"`);
    else attrs = attrs.replace(/\s+$/, '') + ` ${attr}="${val}"`;
    code = code.replace(re, () => `<${tag}${attrs}${self ? ' /' : ''}>`);
  }
  ta.value = code; labUpdate(); beep(700, .05);
}
/* แก้ข้อความระหว่างแท็ก เช่น <heart>3</heart> */
function setText(tag, val){
  const ta = $('code');
  const re = new RegExp('(<' + tag + '(?:\\s[^<>]*)?>)([\\s\\S]*?)(</' + tag + '\\s*>)', 'i');
  if(re.test(ta.value)) ta.value = ta.value.replace(re, (x, a, b, c) => a + val + c);
  else ta.value += `\n<${tag}>${val}</${tag}>`;
  labUpdate(); beep(700, .05);
}
