/* ---------- ตัวช่วย ---------- */
const rand = (a, b) => a + Math.random()*(b-a);
const near = (a, b, r) => (a.x-b.x)*(a.x-b.x) + (a.y-b.y)*(a.y-b.y) < r*r;
function boom(x, y, color, n=14){
  for(let i=0;i<n;i++){
    const a = Math.random()*6.283, s = rand(1, 5);
    parts.push({ x, y, vx: Math.cos(a)*s, vy: Math.sin(a)*s, life: rand(300, 700), max: 700, color });
  }
}
function toast(x, y, text, color='#fff'){ toasts.push({ x, y, text, color, life: 1000 }); }

/* ---------- ยิง ---------- */
function shotPattern(n){
  if(n <= 1) return [{ ox: 0, vx: 0 }];
  if(n === 2) return [{ ox: -7, vx: 0 }, { ox: 7, vx: 0 }];
  if(n === 3) return [{ ox: 0, vx: 0 }, { ox: -8, vx: -2 }, { ox: 8, vx: 2 }];
  return [{ ox: 0, vx: 0 }, { ox: -8, vx: -1.5 }, { ox: 8, vx: 1.5 }, { ox: -12, vx: -3 }, { ox: 12, vx: 3 }];
}
function shoot(){
  const n = p.power > 0 ? (ship.shots >= 3 ? 5 : 3) : ship.shots;
  shotPattern(n).forEach(g => bullets.push({ x: p.x + g.ox, y: p.y - 16, vx: g.vx, vy: -CONFIG.bulletSpeed }));
}
function enemyShoot(e, aimed){
  const sp = CONFIG.enemyBulletSpeed * D().bspd;
  let a = Math.PI/2;
  if(aimed) a = Math.atan2(p.y - e.y, p.x - e.x) + rand(-0.12, 0.12);
  ebullets.push({ x: e.x, y: e.y + 14, vx: Math.cos(a)*sp, vy: Math.sin(a)*sp, c: CONFIG.colors.enemyBullet, r: 5 });
  beep(200, .06, 'square', .02);
}

/* ---------- ศัตรู / บอส / ไอเท็ม ---------- */
function spawnEnemy(){
  const r = Math.random();
  let type = r < 0.35 ? 'drift' : (r < 0.7 ? 'wave' : 'shooter');
  if(kills < 4 && type === 'shooter') type = 'wave';
  const x = rand(60, W-60);
  const fireIv = CONFIG.enemyFireMs / D().fire;
  enemies.push({
    type, x, x0: x, y: -30, r: type === 'shooter' ? 22 : 18,
    hp: type === 'shooter' ? CONFIG.shooterHP : CONFIG.enemyHP,
    vy: CONFIG.enemySpeed * D().spd * rand(0.8, 1.3),
    ph: rand(0, 6), age: 0, hit: 0, hold: rand(90, 230),
    fireT: rand(900, fireIv), fireIv: type === 'shooter' ? fireIv : fireIv * 1.5
  });
}
function spawnBoss(){
  const hp = Math.round(CONFIG.bossHP * D().boss);
  boss = { x: W/2, y: -80, w: 130, h: 80, hp, max: hp, dir: 1, fire: 1200, t: 0, rage: false, volley: 0 };
}
function bossFire(){
  const sp = CONFIG.bossBulletSpeed * D().bspd;
  const fan = boss.rage ? [-0.6, -0.3, 0, 0.3, 0.6] : [-0.35, 0, 0.35];
  fan.forEach(a => ebullets.push({ x: boss.x, y: boss.y + 40, vx: Math.sin(a)*sp, vy: Math.cos(a)*sp, c: CONFIG.colors.bossBullet, r: 6 }));
  if(boss.rage && boss.volley % 2 === 0){
    const a = Math.atan2(p.y - boss.y, p.x - boss.x);
    ebullets.push({ x: boss.x, y: boss.y + 30, vx: Math.cos(a)*sp*1.15, vy: Math.sin(a)*sp*1.15, c: '#ff3b3b', r: 6 });
  }
  boss.volley++; beep(300, .12, 'square', .04);
}
function dropItem(x, y){
