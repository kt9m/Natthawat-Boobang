}
function hurt(){
  if(p.shield > 0 || p.inv > 0 || state !== 'play') return;
  p.lives--; p.inv = 1500; shake = 10;
  boom(p.x, p.y, ship.color, 20);
  beep(150, .25, 'sawtooth', .07);
  if(p.lives <= 0){
    state = 'dying'; boom(p.x, p.y, '#fff', 40);
    setTimeout(() => showEnd(false), 900);
  }
}

/* ---------- อัปเดต ---------- */
function update(dt){
  const k = dt/16.67;
  stars.forEach(s => { s.y += s.z * 1.2 * k; if(s.y > H){ s.y = 0; s.x = Math.random()*W; } });
  gridOff = (gridOff + 1.5*k) % 40;
  parts.forEach(q => { q.x += q.vx*k; q.y += q.vy*k; q.life -= dt; });
  parts = parts.filter(q => q.life > 0);
  toasts.forEach(t => { t.y -= 0.6*k; t.life -= dt; });
  toasts = toasts.filter(t => t.life > 0);
  shake = Math.max(0, shake - 0.6*k); flash = Math.max(0, flash - 0.04*k);

  if(state !== 'play') return;

  /* ยาน */
  let dx = 0, dy = 0;
  if(keys['arrowleft'] || keys['a']) dx -= 1;
  if(keys['arrowright'] || keys['d']) dx += 1;
  if(keys['arrowup'] || keys['w']) dy -= 1;
  if(keys['arrowdown'] || keys['s']) dy += 1;
  if(dx || dy){ p.x += dx*ship.speed*k; p.y += dy*ship.speed*k; tx = p.x; ty = p.y; }
  else {
    const f = Math.min(1, (0.1 + ship.speed*0.028) * k);
    p.x += (tx - p.x) * f; p.y += (ty - p.y) * f;
  }
  p.x = Math.max(20, Math.min(W-20, p.x)); p.y = Math.max(80, Math.min(H-30, p.y));
  p.fire -= dt;
  if(p.fire <= 0){ shoot(); p.fire = ship.fireDelay * (1 + 0.15*(ship.shots-1)); }
  p.power = Math.max(0, p.power - dt); p.shield = Math.max(0, p.shield - dt); p.inv = Math.max(0, p.inv - dt);

  /* ศัตรูมาเรื่อยๆ (ยิ่งเล่นยิ่งมาถี่) */
  if(!bossStarted){
    spawnT -= dt;
    if(spawnT <= 0){
      spawnEnemy();
      spawnT = CONFIG.enemySpawnMs * D().spawn * rand(0.8, 1.2) * (1 - Math.min(0.35, kills*0.012));
    }
  }
  if(!bossStarted && kills >= CONFIG.killsForBoss){ bossStarted = true; warnT = 2200; beep(200, .5, 'sawtooth', .07); }
  if(warnT > 0){ warnT -= dt; if(warnT <= 0) spawnBoss(); }

  /* กระสุนเรา */
  bullets.forEach(b => { b.x += b.vx*k; b.y += b.vy*k; });
  bullets = bullets.filter(b => b.y > -20 && b.x > -20 && b.x < W+20);

  /* ศัตรู */
  enemies.forEach(e => {
    e.age += dt; e.hit = Math.max(0, e.hit - dt);
    const leaving = e.type === 'shooter' && e.age > 7000;
    if(e.type === 'shooter'){
      if(leaving) e.y += e.vy*1.6*k;
      else if(e.y < e.hold) e.y += e.vy*1.3*k;
      else { e.ph += 0.025*k; e.x = Math.max(40, Math.min(W-40, e.x0 + Math.sin(e.ph)*70)); }
    } else {
      e.y += e.vy*k;
      if(e.type === 'wave'){ e.ph += 0.04*k; e.x = e.x0 + Math.sin(e.ph)*45; }
    }
    if(e.type !== 'drift' && !leaving && e.y > 20 && e.y < H-150){
      e.fireT -= dt;
      if(e.fireT <= 0){ e.fireT = e.fireIv * rand(0.8, 1.2); enemyShoot(e, e.type === 'shooter'); }
    }
    bullets.forEach(b => {
      if(!b.dead && !e.dead && near(b, e, e.r + 6)){
        b.dead = true; e.hp--; e.hit = 80; beep(600, .04, 'square', .03);
        if(e.hp <= 0){
          e.dead = true; score += e.type === 'shooter' ? 25 : (e.type === 'wave' ? 15 : 10); kills++;
          boom(e.x, e.y, CONFIG.colors[e.type]);
          beep(240, .12, 'sawtooth', .05);
          if(Math.random() < CONFIG.itemDropChance) dropItem(e.x, e.y);
        }
      }
    });
    if(!e.dead && near(e, p, e.r + p.r)){ e.dead = true; boom(e.x, e.y, CONFIG.colors[e.type]); hurt(); }
  });
  enemies = enemies.filter(e => !e.dead && e.y < H+40);

  /* บอส */
  if(boss){
    boss.t += dt;
    if(!boss.rage && boss.hp <= boss.max/2){
      boss.rage = true; shake = 14; flash = 0.6; toast(boss.x, boss.y + 70, 'บอสโกรธแล้ว!', '#ff3b3b');
      beep(110, .5, 'sawtooth', .08);
    }
    if(boss.y < 120) boss.y += 1.5*k;
    else {
      boss.x += boss.dir * (boss.rage ? 2.6 : 1.7) * k;
      if(boss.x > W-85) boss.dir = -1;
      if(boss.x < 85) boss.dir = 1;
      boss.fire -= dt;
      if(boss.fire <= 0){
        boss.fire = CONFIG.bossFireMs / (0.6 + 0.4*D().fire) * (boss.rage ? 0.65 : 1);
        bossFire();
      }
    }
    bullets.forEach(b => {
      if(!b.dead && Math.abs(b.x-boss.x) < boss.w/2 && Math.abs(b.y-boss.y) < boss.h/2){
        b.dead = true; boss.hp--; boom(b.x, b.y, '#fff', 3); beep(420, .04, 'square', .03);
      }
    });
    if(Math.abs(p.x-boss.x) < boss.w/2 + 8 && Math.abs(p.y-boss.y) < boss.h/2 + 8) hurt();
    if(boss.hp <= 0){
      score += 200; boom(boss.x, boss.y, CONFIG.colors.boss, 80); boom(boss.x, boss.y, '#fff', 40);
      shake = 20; flash = 1; beep(100, .8, 'sawtooth', .09);
      boss = null; ebullets = []; enemies = []; winT = 1600;
    }
  }
  bullets = bullets.filter(b => !b.dead);
  if(winT > 0){ winT -= dt; if(winT <= 0) showEnd(true); }

  /* กระสุนศัตรู / บอส */
  ebullets.forEach(b => { b.x += b.vx*k; b.y += b.vy*k; if(near(b, p, 13)){ b.dead = true; hurt(); } });
  ebullets = ebullets.filter(b => !b.dead && b.y < H+20 && b.y > -30 && b.x > -20 && b.x < W+20);

  /* ไอเท็ม */
  items.forEach(it => { it.y += it.vy*k; it.t += dt; if(near(it, p, it.r + 18)){ it.dead = true; collect(it); } });
  items = items.filter(it => !it.dead && it.y < H+30);
}

/* ---------- วาด ---------- */
function glowC(c, col, b=12){ c.shadowColor = col; c.shadowBlur = b; c.strokeStyle = col; }
function glow(col, b){ glowC(ctx, col, b); }

const SHAPES = {
  arrow: [[0,-24],[15,14],[7,9],[0,16],[-7,9],[-15,14]],
  delta: [[0,-22],[20,16],[0,8],[-20,16]],
  wide:  [[0,-20],[8,-8],[24,8],[22,16],[8,10],[0,14],[-8,10],[-22,16],[-24,8],[-8,-8]],
  round: [[0,-22],[10,-16],[14,-2],[12,12],[5,16],[-5,16],[-12,12],[-14,-2],[-10,-16]]
};
function paintShip(c, x, y, s, shield){
  c.save(); c.translate(x, y);
  const fl = 8 + Math.random()*8;
  c.fillStyle = s.flame; c.shadowColor = s.flame; c.shadowBlur = 14;
  c.beginPath(); c.moveTo(-6, 10); c.lineTo(0, 10 + fl); c.lineTo(6, 10); c.fill();
  glowC(c, s.color, 16); c.lineWidth = 2.5; c.fillStyle = '#031a24';
  c.beginPath();
  SHAPES[s.shape].forEach((q, i) => i ? c.lineTo(q[0], q[1]) : c.moveTo(q[0], q[1]));
  c.closePath(); c.fill(); c.stroke();
  c.fillStyle = s.color; c.beginPath(); c.arc(0, -2, 4, 0, 6.283); c.fill();
  if(shield > 0){
    c.globalAlpha = shield < 1500 ? (Math.floor(shield/150) % 2 ? 0.3 : 1) : 1;
    glowC(c, '#4da6ff', 18); c.lineWidth = 3;
    c.beginPath(); c.arc(0, 0, 28, 0, 6.283); c.stroke();
  }
  c.restore();
}

function drawBG(){
  const g = ctx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, '#02030a'); g.addColorStop(1, '#14033a');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  ctx.save(); ctx.globalAlpha = 0.18; ctx.strokeStyle = '#00f0ff'; ctx.lineWidth = 1;
  for(let y = gridOff; y < H; y += 40){ ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
  for(let x = 0; x <= W; x += 40){ ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
  ctx.restore();
  stars.forEach(s => { ctx.fillStyle = `rgba(200,240,255,${0.25 + s.z*0.35})`; ctx.fillRect(s.x, s.y, s.z*1.5, s.z*1.5); });
}

function drawPlayer(){
  if(state === 'dying') return;
  if(p.inv > 0 && Math.floor(p.inv/100) % 2 === 0) return;
  paintShip(ctx, p.x, p.y, ship, p.shield);
}

function drawEnemy(e){
  const col = CONFIG.colors[e.type];
  ctx.save(); ctx.translate(e.x, e.y);
  glow(col, 14); ctx.lineWidth = 2.5; ctx.fillStyle = e.hit > 0 ? '#ffffff' : '#1a0518';
  ctx.beginPath();
  if(e.type === 'drift'){
    ctx.moveTo(0, 20); ctx.lineTo(18, 0); ctx.lineTo(10, -16); ctx.lineTo(-10, -16); ctx.lineTo(-18, 0);
  } else if(e.type === 'wave'){
    ctx.moveTo(0, 18); ctx.lineTo(20, 2); ctx.lineTo(0, -18); ctx.lineTo(-20, 2);
  } else {
    for(let i=0;i<8;i++){ const a = i*Math.PI/4 + Math.PI/8; ctx.lineTo(Math.cos(a)*22, Math.sin(a)*22); }
  }
  ctx.closePath(); ctx.fill(); ctx.stroke();
  ctx.fillStyle = col;
  if(e.type === 'shooter'){ ctx.fillRect(-4, 14, 8, 12); ctx.fillRect(-9, -5, 18, 7); }
  else { ctx.fillRect(-8, -3, 5, 5); ctx.fillRect(3, -3, 5, 5); }
  ctx.restore();
}

function drawBoss(){
  const b = boss, c = CONFIG.colors.boss;
  ctx.save(); ctx.translate(b.x, b.y);
  glow(c, b.rage ? 30 : 20); ctx.lineWidth = 3; ctx.fillStyle = b.rage ? '#3a0a0a' : '#240606';
  ctx.beginPath();
  ctx.moveTo(-65, -20); ctx.lineTo(-35, -40); ctx.lineTo(35, -40); ctx.lineTo(65, -20);
  ctx.lineTo(45, 20); ctx.lineTo(15, 40); ctx.lineTo(-15, 40); ctx.lineTo(-45, 20); ctx.closePath();
  ctx.fill(); ctx.stroke();
  const pulse = 8 + Math.sin(b.t/(b.rage ? 80 : 150))*3;
  ctx.fillStyle = '#fff'; ctx.shadowColor = c; ctx.shadowBlur = 25;
  ctx.beginPath(); ctx.arc(0, 0, pulse, 0, 6.283); ctx.fill();
  ctx.fillStyle = c; ctx.fillRect(-45, -6, 14, 8); ctx.fillRect(31, -6, 14, 8);
  ctx.restore();
}

function drawItem(it){
  const d = ITEMS[it.type];
  ctx.save(); ctx.translate(it.x, it.y + Math.sin(it.t/200)*3);
  glow(d.color, 16); ctx.lineWidth = 2.5; ctx.fillStyle = '#0a0a1c';
  ctx.beginPath();
  for(let i=0;i<6;i++){ const a = i*Math.PI/3 + Math.PI/6; ctx.lineTo(Math.cos(a)*17, Math.sin(a)*17); }
  ctx.closePath(); ctx.fill(); ctx.stroke();
  ctx.shadowBlur = 0; ctx.fillStyle = d.color; ctx.font = 'bold 18px Tahoma,sans-serif';
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(d.label, 0, 1);
  ctx.restore();
}

function drawHUD(){
  ctx.save(); ctx.textBaseline = 'top';
  ctx.shadowColor = '#00f0ff'; ctx.shadowBlur = 8; ctx.fillStyle = '#00f0ff';
  ctx.font = 'bold 22px "Courier New",monospace'; ctx.textAlign = 'left';
  ctx.fillText('SCORE ' + score, 12, 10);
  ctx.textAlign = 'right'; ctx.fillStyle = '#ff4d8d'; ctx.shadowColor = '#ff4d8d';
  ctx.fillText('♥'.repeat(Math.max(0, p.lives)), W-12, 10);
  ctx.shadowBlur = 0;
  if(!bossStarted){
    ctx.textAlign = 'left'; ctx.font = 'bold 13px Tahoma'; ctx.fillStyle = '#8fb7d6';
    ctx.fillText('ศัตรู ' + Math.min(kills, CONFIG.killsForBoss) + '/' + CONFIG.killsForBoss + ' → บอส', 12, 38);
  }
  let y = H - 22; ctx.textAlign = 'left'; ctx.font = 'bold 13px Tahoma';
  [['P  ยิงเพิ่ม', p.power, CONFIG.powerMs, '#ffe600'], ['S  โล่', p.shield, CONFIG.shieldMs, '#4da6ff']].forEach(([n, v, m, c]) => {
    if(v > 0){
      ctx.fillStyle = c; ctx.fillText(n, 12, y - 14);
      ctx.fillStyle = '#ffffff22'; ctx.fillRect(110, y - 12, 120, 8);
      ctx.fillStyle = c; ctx.fillRect(110, y - 12, 120 * v / m, 8);
      y -= 24;
    }
  });
  if(boss){
    ctx.fillStyle = '#ffffff22'; ctx.fillRect(90, 46, 300, 12);
    ctx.fillStyle = CONFIG.colors.boss; ctx.shadowColor = CONFIG.colors.boss; ctx.shadowBlur = 10;
    ctx.fillRect(90, 46, 300 * Math.max(0, boss.hp) / boss.max, 12);
    ctx.shadowBlur = 0; ctx.fillStyle = '#fff'; ctx.font = 'bold 12px Tahoma'; ctx.textAlign = 'center';
    ctx.fillText('BOSS', W/2, 62);
  }
  if(warnT > 0 && Math.floor(warnT/250) % 2 === 0){
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.font = 'bold 36px Tahoma';
    ctx.fillStyle = '#ff3b3b'; ctx.shadowColor = '#ff3b3b'; ctx.shadowBlur = 24;
    ctx.fillText(CONFIG.text.warning, W/2, H/2 - 40);
  }
  ctx.restore();
}

function draw(){
  ctx.save();
  if(shake > 0) ctx.translate(rand(-shake, shake)/2, rand(-shake, shake)/2);
  drawBG();
  if(state === 'menu'){
    paintShip(ctx, W/2 + Math.sin(performance.now()/600)*60, 330, ship, 0);
  } else {
    items.forEach(drawItem);
    enemies.forEach(drawEnemy);
    if(boss) drawBoss();
    ctx.save();
    glow(ship.bullet, 10); ctx.fillStyle = ship.bullet;
    bullets.forEach(b => ctx.fillRect(b.x-2, b.y-8, 4, 14));
    ebullets.forEach(b => {
      glow(b.c, 12); ctx.fillStyle = b.c; ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, 6.283); ctx.fill();
      ctx.shadowBlur = 0; ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(b.x, b.y, b.r*0.4, 0, 6.283); ctx.fill();
    });
    ctx.restore();
    drawPlayer();
    parts.forEach(q => { ctx.globalAlpha = Math.max(0, q.life / q.max); ctx.fillStyle = q.color; ctx.fillRect(q.x-2, q.y-2, 4, 4); });
    ctx.globalAlpha = 1;
    toasts.forEach(t => {
      ctx.save(); ctx.globalAlpha = Math.min(1, t.life/400); ctx.textAlign = 'center';
      ctx.font = 'bold 20px Tahoma'; ctx.fillStyle = t.color; ctx.shadowColor = t.color; ctx.shadowBlur = 10;
      ctx.fillText(t.text, t.x, t.y - 20); ctx.restore();
    });
    drawHUD();
  }
  ctx.restore();
  if(flash > 0){ ctx.fillStyle = `rgba(255,255,255,${flash*0.6})`; ctx.fillRect(0, 0, W, H); }
}

/* ตัวอย่างยานในห้องแต่งยาน */
function drawPreview(){
  const c = pvx, w = pv.width, h = pv.height, t = performance.now();
  c.fillStyle = '#05061a'; c.fillRect(0, 0, w, h);
  c.save(); c.globalAlpha = 0.15; c.strokeStyle = '#00f0ff';
  const off = (t*0.05) % 20;
  for(let y = off; y < h; y += 20){ c.beginPath(); c.moveTo(0, y); c.lineTo(w, y); c.stroke(); }
  for(let x = 0; x < w; x += 20){ c.beginPath(); c.moveTo(x, 0); c.lineTo(x, h); c.stroke(); }
  c.restore();
  const sx = w/2 + Math.sin(t/900)*40, sy = h - 32;
  const ph = (t*0.14) % 34;
  c.save(); glowC(c, labShip.bullet, 10); c.fillStyle = labShip.bullet;
  shotPattern(labShip.shots).forEach(g => {
    for(let i = 0; i < 4; i++){
      const dy = ph + i*34; c.fillRect(sx + g.ox + g.vx*dy/10 - 2, sy - 16 - dy, 4, 12);
    }
  });
  c.restore();
  paintShip(c, sx, sy, labShip, 0);
  c.textAlign = 'left';
  c.fillStyle = '#9dff00'; c.font = 'bold 18px Tahoma'; c.fillText(labShip.name, 8, 22);
  c.fillStyle = '#8fb7d6'; c.font = '13px Tahoma'; c.fillText(labShip.slogan, 8, 40);
  c.fillStyle = '#ff4d8d'; c.font = 'bold 16px Tahoma'; c.fillText('♥'.repeat(labShip.lives), 8, 62);
}

function loop(t){
  const dt = Math.min(40, t - last || 16); last = t;
  if(state === 'lab') drawPreview();
  else { update(dt); draw(); }
  requestAnimationFrame(loop);
}
refreshHome();
show('home');
requestAnimationFrame(loop);
</script>
</body>
